# ghostty +show-config --default --docs
# https://ghostty.org/docs/config/reference

# Based on Ghostty 1.2.0
# To reload, Press <Shift+Cmd+,>

####################################################################################################
# General
####################################################################################################

# some programs do not recognize TERM=xterm-ghostty, so use the classic one
term = xterm-256color

####################################################################################################
# Fonts
####################################################################################################

# Reset inherited/appended fallback fonts, then set the primary font explicitly.
font-family = ""
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

adjust-cell-width = 0
adjust-cell-height = 0

####################################################################################################
# Colors and Appearances
####################################################################################################

# Tab style: use the native style, not transparent
# https://ghostty.org/docs/config/reference#macos-titlebar-style
macos-titlebar-style = native

# Windows split
split-divider-color = #333333

# Colors
theme = "Espresso"

bold-is-bright = true
selection-invert-fg-bg = true


####################################################################################################
# Keys
####################################################################################################

macos-option-as-alt = left

# Use physical QWERTY positions for Ctrl chords. This keeps shortcuts working
# while a non-Latin input source is active, even when the child enables the
# Kitty keyboard protocol.
keybind = ctrl+KeyA=text:\x01
keybind = ctrl+KeyB=text:\x02
keybind = ctrl+KeyC=text:\x03
keybind = ctrl+KeyD=text:\x04
keybind = ctrl+KeyE=text:\x05
keybind = ctrl+KeyF=text:\x06
keybind = ctrl+KeyG=text:\x07
keybind = ctrl+KeyH=text:\x08
keybind = ctrl+KeyI=text:\x09
keybind = ctrl+KeyJ=text:\x0a
keybind = ctrl+KeyK=text:\x0b
keybind = ctrl+KeyL=text:\x0c
keybind = ctrl+KeyM=text:\x0d
keybind = ctrl+KeyN=text:\x0e
keybind = ctrl+KeyO=text:\x0f
keybind = ctrl+KeyP=text:\x10
keybind = ctrl+KeyQ=text:\x11
keybind = ctrl+KeyR=text:\x12
keybind = ctrl+KeyS=text:\x13
keybind = ctrl+KeyT=text:\x14
keybind = ctrl+KeyU=text:\x15
keybind = ctrl+KeyV=text:\x16
keybind = ctrl+KeyW=text:\x17
keybind = ctrl+KeyX=text:\x18
keybind = ctrl+KeyY=text:\x19
keybind = ctrl+KeyZ=text:\x1a

# Make Option+Backspace send Meta-Backspace (ESC + DEL) for TUI apps.
keybind = alt+backspace=text:\x1b\x7f

# Navigation across ghostty window split, ctrl+cmd+{h,j,k,l}  (in addition to cmd+[ and cmd+])
keybind = unconsumed:ctrl+cmd+k=goto_split:top
keybind = unconsumed:ctrl+cmd+j=goto_split:bottom
keybind = unconsumed:ctrl+cmd+h=goto_split:left
keybind = unconsumed:ctrl+cmd+l=goto_split:right


####################################################################################################
# Etc.
####################################################################################################

# On macOS, hold Command while hovering/clicking a detected URL or file path.
link-url = true

macos-non-native-fullscreen = visible-menu

